generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserRole {
  CLIENT
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique @db.VarChar(32)
  name         String   @db.VarChar(80)
  phone        String   @db.VarChar(24)
  passwordHash String
  role         UserRole @default(CLIENT)
  bookings     Booking[]
  vehicles     Vehicle[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([role])
}

model Booking {
  id              Int             @id @default(autoincrement())
  userId          Int?
  vehicleId       Int?
  stationId       Int
  serviceId       Int
  workPostId      Int
  customerName    String
  phone           String
  vehicle         String
  startsAt        DateTime        @db.Timestamptz(3)
  endsAt          DateTime        @db.Timestamptz(3)
  durationMinutes Int
  priceAmount     Int?
  status          BookingStatus   @default(PENDING)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  savedVehicle    Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  workPostService WorkPostService @relation(fields: [workPostId, stationId, serviceId], references: [workPostId, stationId, serviceId], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, startsAt])
  @@index([vehicleId])
  @@index([stationId, startsAt])
  @@index([serviceId, startsAt])
  @@index([workPostId, startsAt])
  @@index([status, startsAt])
}

model Vehicle {
  id        Int       @id @default(autoincrement())
  userId    Int
  name      String    @db.VarChar(120)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model Station {
  id                 Int                        @id @default(autoincrement())
  slug               String                     @unique
  name               String
  address            String
  phone              String?
  timezone           String                     @default("Asia/Qyzylorda")
  isActive           Boolean                    @default(true)
  services           StationService[]
  workPosts          WorkPost[]
  workingPeriods     StationWorkingPeriod[]
  scheduleExceptions StationScheduleException[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([isActive])
}

model Service {
  id              Int              @id @default(autoincrement())
  slug            String           @unique
  name            String
  description     String
  category        String
  durationMinutes Int
  priceFrom       Int
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  stations        StationService[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([isActive, sortOrder])
}

model StationService {
  stationId       Int
  serviceId       Int
  durationMinutes Int
  priceFrom       Int
  isActive        Boolean           @default(true)
  station         Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  workPosts       WorkPostService[]

  @@id([stationId, serviceId])
  @@index([serviceId, isActive])
  @@index([stationId, isActive])
}

model WorkPostType {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  name        String
  description String?
  isActive    Boolean    @default(true)
  workPosts   WorkPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
}

model WorkPost {
  id        Int                @id @default(autoincrement())
  stationId Int
  typeId    Int
  code      String
  name      String
  isActive  Boolean            @default(true)
  sortOrder Int                @default(0)
  station   Station            @relation(fields: [stationId], references: [id], onDelete: Cascade)
  type      WorkPostType       @relation(fields: [typeId], references: [id], onDelete: Restrict)
  services  WorkPostService[]
  downtimes WorkPostDowntime[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([stationId, code])
  @@unique([id, stationId])
  @@index([stationId, isActive])
  @@index([typeId, isActive])
}

model WorkPostService {
  workPostId     Int
  stationId      Int
  serviceId      Int
  workPost       WorkPost       @relation(fields: [workPostId, stationId], references: [id, stationId], onDelete: Cascade)
  stationService StationService @relation(fields: [stationId, serviceId], references: [stationId, serviceId], onDelete: Cascade)
  bookings       Booking[]

  @@id([workPostId, serviceId])
  @@unique([workPostId, stationId, serviceId])
  @@index([stationId, serviceId])
}

model StationWorkingPeriod {
  id           Int     @id @default(autoincrement())
  stationId    Int
  weekday      Int     @db.SmallInt
  startsMinute Int
  endsMinute   Int
  station      Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, weekday, startsMinute, endsMinute])
  @@index([stationId, weekday])
}

model StationScheduleException {
  id           Int      @id @default(autoincrement())
  stationId    Int
  date         DateTime @db.Date
  isClosed     Boolean  @default(true)
  startsMinute Int?
  endsMinute   Int?
  reason       String?
  station      Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, date])
}

model WorkPostDowntime {
  id         Int      @id @default(autoincrement())
  workPostId Int
  startsAt   DateTime @db.Timestamptz(3)
  endsAt     DateTime @db.Timestamptz(3)
  reason     String?
  workPost   WorkPost @relation(fields: [workPostId], references: [id], onDelete: Cascade)

  @@index([workPostId, startsAt, endsAt])
}
